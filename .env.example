# ===================================================
# POLYMARKINGS - Configuration
# ===================================================
# Copy this to .env and fill in your values

# === POLYMARKET API ===
POLYMARKET_API_URL=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
PRIVATE_KEY=your_wallet_private_key_here
PROXY_ADDRESS=your_proxy_address_here

# === TRADING PARAMETERS ===
INITIAL_BANKROLL=5
MAX_BET_FRACTION=0.15
MIN_EDGE=0.03
ASSETS=BTC,ETH,SOL,XRP

# === WALLET SCANNER ===
SCANNER_BATCH_SIZE=500
SCANNER_TARGET_WALLETS=14000
SCANNER_REFRESH_INTERVAL=300000

# === KELLY CRITERION ===
# Fraction of full Kelly to use (0.25 = quarter kelly, safer)
KELLY_FRACTION=0.25
MIN_CONFIDENCE=0.55
MAX_DRAWDOWN_PCT=0.5

# === SYSTEM ===
LOG_LEVEL=info
DB_PATH=./data/polymarkings.db
VPS_MODE=true
